<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cm_title"
                android:textColor="#4F46E5"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cm_subtitle"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cm_description"
                android:textColor="#475569"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@id/billInput"
                android:text="@string/cm_bill_label"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/billInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4F46E5"
                android:hint="@string/cm_bill_hint"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:maxLength="12"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/tipInput"
                android:text="@string/cm_tip_label"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tipInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4F46E5"
                android:hint="@string/cm_tip_hint"
                android:text="@string/cm_default_tip"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:maxLength="12"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="20sp" />

            <Button
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#4F46E5"
                android:text="@string/cm_calculate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/cm_results"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cm_tip_amount_label"
                android:textColor="#475569"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tipAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cm_pending"
                android:textColor="#4F46E5"
                android:textSize="28sp"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite"
                android:freezesText="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/cm_total_label"
                android:textColor="#475569"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/totalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cm_pending"
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite"
                android:freezesText="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cm_note"
                android:textColor="#475569"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
